# Bring a CLEAN source tree into the image so install.sh provisions tpcds-kit +
# the TPC-DS schema from scratch (both are .gitignored / regenerated). Patterns
# stand alone — Docker does not support trailing inline comments.

# Regenerated by install.sh on first run
tpcds-kit
**/*_schema.sql
tests/queries

# Machine-local / heavy
.venv
venv
.git
paper/work

# Caches / build noise
**/__pycache__
*.pyc
*.egg-info
.pytest_cache
.vscode
.idea
.DS_Store
